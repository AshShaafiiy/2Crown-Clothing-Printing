rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{id} {
      allow read: if resource.data.active == true;
    }
    match /categories/{id} {
      allow read: if resource.data.active == true;
    }
    match /promotions/{id} {
      allow read: if resource.data.active == true;
    }
    match /settings/{id} {
      allow read: if true;
    }
    match /{document=**} {
      allow read, write: if false; // Default deny
    }
  }
}
